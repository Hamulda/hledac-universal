{
  "name": "exa_manual",
  "manual_version": "1.0.0",
  "utcp_version": "1.0.1",
  "tools": [
    {
      "name": "exa_list",
      "description": "Modern replacement for ls with colors and icons",
      "inputs": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Directory to list (default: current)" },
          "long": { "type": "boolean", "description": "Long format with details" },
          "recursive": { "type": "boolean", "description": "Recursive listing" }
        }
      },
      "tool_call_template": {
        "call_template_type": "cli",
        "command": "exa",
        "args": ["--icons", "-la", "${path:.}", "${recursive:+--recursive}"]
      }
    },
    {
      "name": "exa_tree",
      "description": "Show directory tree view",
      "inputs": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Directory to show (default: current)" },
          "depth": { "type": "number", "description": "Max depth (default: 3)" }
        },
        "required": ["path"]
      },
      "tool_call_template": {
        "call_template_type": "cli",
        "command": "exa",
        "args": ["--tree", "--level", "${depth:-3}", "${path}"]
      }
    }
  ]
}
