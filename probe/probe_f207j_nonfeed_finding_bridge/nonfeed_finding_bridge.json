  "design_decisions": [
    {
      "decision": "blake2b for deterministic finding IDs",
      "rationale": "hash() builtin is non-deterministic across Python processes. BLAKE2b-128 with per-type salt provides deterministic, collision-resistant IDs.",
      "alternatives_considered": ["SHA-256 (slower)", "hash() builtin (non-deterministic)"]
    },
    {
      "decision": "Confidence scores per source family",
      "rationale": "CT certs are authoritative but stale (0.6). Wayback diff has archival provenance (0.75). PassiveDNS is passive observation (0.5)."
    },
    {
      "decision": "Rejection reasons over exceptions",
      "rationale": "Fail-soft: each adapter result is independently evaluated. A rejection is metadata, not a crash."
    },
    {
      "decision": "Separate _PRIVATE_HOSTNAMES frozenset",
      "rationale": "CT private host check needs its own set. Not shared with PDNS private IP prefixes."
    },
    {
      "decision": "Return (findings, rejections) tuple",
      "rationale": "Bipartite return: findings for the happy path, rejection reasons for observability/debugging."
    }
  ],
