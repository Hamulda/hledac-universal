# Hledac Universal — Environment Variables Reference
# ================================================
# Copy to .env and customize for your environment.
# All variables are optional; defaults are tuned for M1 8GB MacBook Air.

# STORAGE — RAM Disk vs SSD

# Path to RAM disk mount point.
# - Default: /Volumes/ghost_tmp (pre-mounted)
# - Auto-created: /tmp/hledac_ramdisk (2GB HFS+, created at runtime)
# - SSD fallback: ~/.hledac_fallback_ramdisk
HLEDAC_RAMDISK=
GHOST_RAMDISK=

# Set to "1" if RAM disk was auto-created by hledac at runtime.
HLEDAC_RAMDISK_AUTO_CREATED=

# SSD OPTIMIZATION HINT — LIBC_PERF_OPT
# Set to "1" when running on SSD (no RAM disk) to enable SSD-optimized paths.
# On macOS /tmp is APFS (SSD-backed, cached) — fast enough for testing.
LIBC_PERF_OPT=0

# DATA STORES — Paths

# Sprint artifact store (Parquet, JSON reports, next-seeds)
HLEDAC_SPRINT_STORE=

# DuckDB shadow store path
HLEDAC_DUCKDB_STORE=

# LMDB metadata store path
HLEDAC_LMDB_STORE=

# LanceDB embeddings store path
HLEDAC_LANCEDB_STORE=

# DuckDB temp directory (on RAM disk)
HLEDAC_DUCKDB_RAMDISK_TEMP=

# LMDB map_size in MB (M1 8GB ceiling: 256MB)
GHOST_LMDB_MAX_SIZE_MB=256

# DEDUPLICATION STORES

# Full LMDB path override for dedup store
HLEDAC_DEDUP_LMDB_PATH=

# Bloom filter directory for URL dedup
HLEDAC_DEDUP_BLOOM_DIR=

# DuckDB in-process mode (saves ~200MB RAM)
HLEDAC_DUCKDB_INPROCESS=1

# DuckDB thread count (optimal for M1 8GB: 2)
HLEDAC_DUCKDB_THREADS=2

# HTTP/3 (QUIC) support via curl_cffi Alt-Svc
HLEDAC_ENABLE_HTTPX_H3=1

# Arrow zero-copy ingest for DuckDB
HLEDAC_ARROW_INGEST=1

# ── Python 3.14 JIT ─────────────────────────────────────────────────────────
# Python 3.14 copy-and-patch JIT compiler (experimental).
# M1 8GB safe: JIT cache ~20-30 MB, CPU-bound ops (IOC extraction, NER,
# dedup) get 10-30% speedup. Auto-enabled via pyproject.toml [tool.uv.env].
# Override here only if you need to disable JIT explicitly.
# PYTHON_JIT=0 → disable JIT (not recommended on M1 8GB)
# PYTHON_JIT=1 → force enable (use only if UV_JIT_VERIFY fails)
# Empty/unset → auto-detect via sys._jit_enabled at runtime
# NOTE: uv run automatically sets PYTHON_JIT=1 via [tool.uv.env] in pyproject.toml
PYTHON_JIT=
